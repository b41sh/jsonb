# Dictionary for the `json_text` and `binary_ops` fuzz targets: JSON text,
# including the extended syntax that `parse_value` accepts.

# Literals, in both spellings the extended parser accepts.
"null"
"NULL"
"true"
"TRUE"
"false"
"FALSE"
"NaN"
"nan"
"Infinity"
"-Infinity"
"infinity"

# Structure.
"["
"]"
"{"
"}"
":"
","
"[]"
"{}"
"[,]"
"{\"\":"
"\""
"'"

# Strings and escapes.
"\\\""
"\\\\"
"\\/"
"\\b"
"\\f"
"\\n"
"\\r"
"\\t"
"\\u0000"
"\\u001F"
"\\u00e9"
"\\uD83D\\uDE00"
"\\uD800"
"\\uDC00"
"\\u{1F600}"

# Numbers, including extended forms and boundaries.
"-0"
"-0.0"
"0.0"
"+1"
"007"
".5"
"1."
"1e"
"1E+"
"1e-400"
"1e400"
"0x1F"
"0X1f.8"
"-0x8000000000000000"
"9223372036854775807"
"-9223372036854775808"
"18446744073709551615"
"18446744073709551616"
"99999999999999999999999999999999999999"
"0.00000000000000000000000000000000000001"
"9999999999999999999999999999999999999999999999999999999999999999999999999999"

# Whitespace.
" "
"\x09"
"\x0A"
"\x0D"

# Separator between the two values in `binary_ops`.
"\x00"
